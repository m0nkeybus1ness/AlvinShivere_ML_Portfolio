      },
      "outputs": [],
      "source": [
        "from sklearn.datasets import load_iris\n",
        "\n",
        "# The target variable will be the class name.\n",
        "# This dataset is ideal because the characteristics of each flower's petals can\n",
        "# be used to classify the different flowers."
