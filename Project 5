      ],
      "source": [
        "from sklearn.datasets import fetch_openml\n",
        "mnist = fetch_openml('mnist_784', as_frame=False)\n",
        "\n",
        "X = mnist.data\n",
        "y = mnist.target.astype(int)\n",
        "\n",
        "print(X.shape)\n",
        "\n",
        "# This imports the mnist dataset which is one of the inbuilt datasets with high\n",
        "# dimensionality.\n",
        "# The dataset conists of images that are 28 x 28 pixels large, so the\n",
        "# dimensionality is 784\n",
        "# Dimensionality reduction would be good because it will reduce overfitting and\n",
        "# allow the model to run faster because of the reduced dimensions"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# 2. Setup and Reproducibility"
      ],
      "metadata": {
        "id": "DI_EbThfCL6h"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 16,
      "metadata": {
        "id": "7FALbbDqlhIm",
        "colab": {
          "base_uri": "https://localhost:8080/"
