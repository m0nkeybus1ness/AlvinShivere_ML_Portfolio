      "cell_type": "markdown",
      "source": [
        "# 5. Apply t-SNE"
      ],
      "metadata": {
        "id": "TsnAZFGZoM4s"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.manifold import TSNE\n",
        "\n",
        "X_subset = X_scaled[:10000]\n",
        "y_subset = y[:10000]\n",
        "\n",
        "tsne = TSNE(n_components=2, perplexity=30, random_state=seed)\n",
        "X_tsne = tsne.fit_transform(X_subset)\n",
        "\n",
        "plt.scatter(X_tsne[:, 0], X_tsne[:, 1], c=y_subset, cmap=\"tab10\", s=5)\n",
        "plt.colorbar()\n",
        "plt.title(\"t-SNE of MNIST dataset\")\n",
        "plt.show()"
      ],
