    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "IbvNjXSFmW8h",
        "outputId": "5135eb32-bab8-4f26-9289-5fbd56c2c051"
      },
      "outputs": [
        {
          "output_type": "stream",
