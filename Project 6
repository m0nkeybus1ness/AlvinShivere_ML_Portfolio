      ],
      "source": [
        "import tensorflow as tf\n",
        "f_mnist = tf.keras.datasets.fashion_mnist\n",
        "(X_train, y_train), (X_test, y_test) = f_mnist.load_data()\n",
        "print(X_train.shape)\n",
        "\n",
        "# There are 60000 entries for the input, and they each have 28 x 28 pixels\n",
        "# There are 10 different classes in the fashion mnist dataset\n",
        "# ANN is appropriate for this dataset because there is structured numeric pixel\n",
        "# data."
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#2. Setup and Reproducibility"
