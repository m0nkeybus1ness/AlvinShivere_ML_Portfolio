      "source": [
        "import numpy as np\n",
        "import random\n",
        "\n",
        "seed = 42\n",
        "np.random.seed(seed)\n",
        "random.seed(seed)\n",
        "tf.random.set_seed(seed)\n",
        "\n",
        "print(\"numpy: \" + np.__version__)\n",
        "print(\"tensorflow: \" + tf.__version__)\n",
        "print(\"keras: \" + tf.keras.__version__)"
      ]
