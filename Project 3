    {
      "cell_type": "markdown",
      "source": [
        "#4. Kernel SVM"
      ],
      "metadata": {
        "id": "mTlFcxrnWYXu"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.svm import SVC\n",
        "\n",
        "# Making the poly kernel svm\n",
        "poly_kernel_svm_clf = make_pipeline(StandardScaler(), SVC(\n",
        "    kernel='poly', degree=3, coef0=100, C=5))\n",
        "poly_kernel_svm_clf.fit(X_train, y_train)\n",
        "\n",
        "# Making the RBF kernel svm\n",
        "rbf_kernel_svm_clf = make_pipeline(StandardScaler(), SVC(\n",
        "    kernel='rbf', gamma=10, C=1))\n",
        "rbf_kernel_svm_clf.fit(X_train, y_train)\n",
        "\n",
        "# Function to visualize SVM models\n",
        "def plot_decision_boundary(model, X, y, title):\n",
        "    # Create grid\n",
        "    x_min, x_max = X[:,0].min()-1, X[:,0].max()+1\n",
        "    y_min, y_max = X[:,1].min()-1, X[:,1].max()+1\n",
        "\n",
        "    xx, yy = np.meshgrid(\n",
        "        np.linspace(x_min, x_max, 300),\n",
        "        np.linspace(y_min, y_max, 300)\n",
        "    )\n",
        "\n",
        "    # Predict\n",
        "    Z = model.predict(np.c_[xx.ravel(), yy.ravel()])\n",
        "    Z = Z.reshape(xx.shape)\n",
        "\n",
        "    # Plot boundary\n",
        "    plt.contourf(xx, yy, Z, alpha=0.3)\n",
        "\n",
        "    # Plot data\n",
        "    plt.scatter(X[:,0], X[:,1], c=y, edgecolors='k')\n",
        "\n",
        "    plt.title(title)\n",
        "    plt.grid(True, linestyle='--', alpha=0.6)\n",
        "    plt.show()\n",
        "\n",
        "# Plotting poly svm\n",
        "plot_decision_boundary(poly_kernel_svm_clf, X_train, y_train, \"Poly Kernel SVM\")\n",
        "\n",
        "# Plotting rbf svm\n",
        "plot_decision_boundary(rbf_kernel_svm_clf, X_train, y_train, \"RBF Kernel SVM\")\n",
        "\n",
        "# Poly accuracy and confusion matrix\n",
        "y_pred = poly_kernel_svm_clf.predict(X_test)\n",
        "print(\"Accuracy: \", accuracy_score(y_test, y_pred))\n",
        "print(\"Confusion Matrix: \\n\", confusion_matrix(y_test, y_pred))\n",
        "\n",
        "# RBF accuracy and confusion matrix\n",
        "y_pred = rbf_kernel_svm_clf.predict(X_test)\n",
        "print(\"Accuracy: \", accuracy_score(y_test, y_pred))\n",
        "print(\"Confusion Matrix: \\n\", confusion_matrix(y_test, y_pred))"
      ],
